{
  "permissions": {
    "allow": [
      "Bash(powershell -NoProfile -Command \"wsl -d Ubuntu -- bash -lc 'cd /mnt/c/Users/rifra/AppData/Local/Temp/claude/c--Users-rifra--gemini-antigravity-ide-scratch-ai-second-brain/341128d6-9d2e-4be1-80c9-c208a815ff2a/scratchpad && timeout 420 python3 wa_list_docs.py Hariyadi 70 2>&1 | tail -40'\")"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "~/You/You",
      "~/antigravity-projects/You"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session_git_sync.sh\"",
            "shell": "bash",
            "timeout": 45,
            "statusMessage": "Syncing with GitHub..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'command -v python3 >/dev/null 2>&1 || exit 0; exec python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/dashboard_context.py\"'",
            "timeout": 10,
            "statusMessage": "Loading dashboard context (trimmed)..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/wib_clock.sh\"",
            "timeout": 5,
            "statusMessage": "Checking WIB clock..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/glm_mode.sh\"",
            "timeout": 5,
            "statusMessage": "Checking GLM mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/routing_mode.sh\"",
            "timeout": 5,
            "statusMessage": "Checking routing mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && bash .agent/scripts/ensure_dashboard.sh >/dev/null 2>&1 &",
            "timeout": 10,
            "statusMessage": "Ensuring dashboard (localhost:3737)..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/upstream_check.sh\"",
            "timeout": 15,
            "statusMessage": "Checking for harness updates..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Ss]lack.*__.*(post|send|reply).*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/slack_send_guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/drive_verify.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/emdash_guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "alwaysThinkingEnabled": true
}
